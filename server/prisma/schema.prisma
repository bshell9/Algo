generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ═══════════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════════

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String   @default("csr") // admin, manager, csr, technician, dispatcher, accounting
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  shopId        String?
  podId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop              Shop?              @relation(fields: [shopId], references: [id])
  pod               Pod?               @relation(fields: [podId], references: [id])
  workOrdersTech    WorkOrder[]        @relation("TechnicianOrders")
  workOrdersCSR     WorkOrder[]        @relation("CSROrders")
  scheduleEntries   ScheduleEntry[]
  notifications     Notification[]
  posSessionsOpened POSSession[]       @relation("SessionUser")
  payments          Payment[]          @relation("ProcessedBy")
  cashDrawerActions CashDrawerAction[]
  auditLogs         AuditLog[]

  @@index([shopId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ═══════════════════════════════════════════════
// SHOP / LOCATIONS (4 shops)
// ═══════════════════════════════════════════════

model Shop {
  id         String  @id @default(uuid())
  name       String
  code       String  @unique // e.g. "SHOP1", "SHOP2"
  address    String
  city       String
  state      String
  zip        String
  phone      String
  email      String
  fein       String?
  nagsId     String?
  timezone   String  @default("America/Chicago")
  isActive   Boolean @default(true)
  taxRate    Float   @default(0.0)
  laborRate  Float   @default(50.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users           User[]
  pods            Pod[]
  workOrders      WorkOrder[]
  scheduleEntries ScheduleEntry[]
  inventoryItems  ShopInventory[]
  invoices        Invoice[]
  posSessions     POSSession[]
  quotes          Quote[]
  purchaseOrders  PurchaseOrder[]
  transfersFrom   InventoryTransfer[] @relation("TransferFrom")
  transfersTo     InventoryTransfer[] @relation("TransferTo")
}

// ═══════════════════════════════════════════════
// CUSTOMERS
// ═══════════════════════════════════════════════

model Customer {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String
  altPhone     String?
  address      String?
  city         String?
  state        String?
  zip          String?
  company      String?
  source       String  @default("walk_in")
  isFleet      Boolean @default(false)
  fleetName    String?
  notes        String?
  totalJobs    Int     @default(0)
  totalRevenue Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles    Vehicle[]
  workOrders  WorkOrder[]
  invoices    Invoice[]
  quotes      Quote[]

  @@index([phone])
  @@index([lastName])
  @@index([email])
  @@index([company])
}

// ═══════════════════════════════════════════════
// VEHICLES
// ═══════════════════════════════════════════════

model Vehicle {
  id             String  @id @default(uuid())
  customerId     String
  vin            String?
  year           Int
  make           String
  model          String
  subModel       String?
  bodyStyle      String?
  color          String?
  plateNumber    String?
  plateState     String?
  nagsVehicleId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@index([customerId])
  @@index([vin])
  @@index([year, make, model])
}

// ═══════════════════════════════════════════════
// WORK ORDERS
// ═══════════════════════════════════════════════

model WorkOrder {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  shopId          String
  customerId      String
  vehicleId       String
  podId           String?
  technicianId    String?
  csrId           String?
  status          String   @default("pending")
  jobType         String   @default("replacement")
  glassPosition   String   @default("windshield")

  // Schedule
  scheduledDate   DateTime?
  scheduledSlot   String?
  scheduledTime   String?
  serviceLocation String   @default("shop") // shop, mobile, customer
  serviceAddress  String?
  serviceCity     String?
  serviceState    String?
  serviceZip      String?

  // Part Info (NAGS)
  nagsPartNumber  String?
  partDescription String?
  partType        String   @default("aftermarket")
  glassVendor     String?

  // Pricing
  retailPrice     Float    @default(0)
  partCost        Float    @default(0)
  laborCost       Float    @default(0)
  moldingCost     Float    @default(0)
  kitCost         Float    @default(0)
  otherCharges    Float    @default(0)
  discount        Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)

  // Insurance
  isInsuranceJob       Boolean @default(false)
  insuranceCompanyCode String?
  claimNumber          String?
  policyNumber         String?
  deductible           Float   @default(0)
  insurancePays        Float   @default(0)
  customerPays         Float   @default(0)

  // ADAS Calibration
  requiresCalibration Boolean @default(false)
  calibrationType     String?
  calibrationCost     Float   @default(0)

  // Notes
  csrNotes       String?
  techNotes      String?
  dispatchNotes  String?

  // Timestamps
  dispatchedAt   DateTime?
  arrivedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop           Shop             @relation(fields: [shopId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  pod            Pod?             @relation(fields: [podId], references: [id])
  technician     User?            @relation("TechnicianOrders", fields: [technicianId], references: [id])
  csr            User?            @relation("CSROrders", fields: [csrId], references: [id])
  lineItems      WorkOrderLineItem[]
  scheduleEntry  ScheduleEntry?
  invoice        Invoice?
  claim          InsuranceClaim?

  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([orderNumber])
  @@index([podId])
  @@index([technicianId])
}

model WorkOrderLineItem {
  id              String @id @default(uuid())
  workOrderId     String
  description     String
  nagsPartNumber  String?
  partType        String?
  quantity        Int    @default(1)
  unitPrice       Float
  cost            Float  @default(0)
  total           Float
  isTaxable       Boolean @default(true)
  category        String  @default("glass") // glass, molding, hardware, urethane, labor, calibration, other
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ═══════════════════════════════════════════════
// PODS (Mobile Service Units)
// ═══════════════════════════════════════════════

model Pod {
  id               String  @id @default(uuid())
  name             String
  code             String  @unique // e.g. "POD-01"
  vehiclePlate     String?
  vehicleMake      String?
  vehicleModel     String?
  vehicleYear      Int?
  shopId           String
  status           String  @default("available")
  currentLat       Float?
  currentLng       Float?
  lastLocationUpdate DateTime?
  maxJobsPerDay    Int     @default(6)
  serviceRadius    Int     @default(50) // miles
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  technicians    User[]
  workOrders     WorkOrder[]
  scheduleEntries ScheduleEntry[]
  podInventory   PodInventory[]

  @@index([shopId])
  @@index([status])
}

// ═══════════════════════════════════════════════
// INVENTORY (Multi-Location NAGS)
// ═══════════════════════════════════════════════

// Master catalog of all NAGS parts
model NAGSPart {
  id              String  @id @default(uuid())
  nagsPartNumber  String  @unique
  description     String
  partType        String  @default("aftermarket") // oem, oee, aftermarket, dealer
  glassPosition   String?
  fitsYearFrom    Int?
  fitsYearTo      Int?
  fitsMake        String?
  fitsModel       String?
  fitsSubModel    String?
  fitsBodyStyle   String?
  width           Float?
  height          Float?
  thickness       Float?
  tinted          Boolean @default(false)
  heated          Boolean @default(false)
  antenna         Boolean @default(false)
  sensor          Boolean @default(false) // rain sensor
  adasCompatible  Boolean @default(false)
  encapsulated    Boolean @default(false)
  vendor          String?
  vendorPartNumber String?
  listPrice       Float   @default(0)
  cost            Float   @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shopInventory  ShopInventory[]
  podInventory   PodInventory[]
  moldingKits    MoldingKit[]

  @@index([nagsPartNumber])
  @@index([fitsMake, fitsModel])
  @@index([fitsYearFrom, fitsYearTo])
  @@index([glassPosition])
}

// Inventory per shop location
model ShopInventory {
  id              String  @id @default(uuid())
  shopId          String
  nagsPartId      String
  quantity        Int     @default(0)
  minQuantity     Int     @default(1)
  maxQuantity     Int     @default(10)
  reorderPoint    Int     @default(2)
  cost            Float   @default(0)
  retailPrice     Float   @default(0)
  binLocation     String? // e.g. "A-3-2" (aisle-rack-shelf)
  status          String  @default("in_stock")
  lastCountedAt   DateTime?
  lastOrderedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id])
  nagsPart NAGSPart @relation(fields: [nagsPartId], references: [id])

  @@unique([shopId, nagsPartId])
  @@index([shopId])
  @@index([nagsPartId])
  @@index([status])
  @@index([quantity])
}

// Inventory loaded on each pod/van
model PodInventory {
  id          String @id @default(uuid())
  podId       String
  nagsPartId  String
  quantity    Int    @default(0)
  loadedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pod      Pod      @relation(fields: [podId], references: [id])
  nagsPart NAGSPart @relation(fields: [nagsPartId], references: [id])

  @@unique([podId, nagsPartId])
  @@index([podId])
}

// Molding and hardware kits associated with glass parts
model MoldingKit {
  id              String @id @default(uuid())
  nagsPartId      String
  moldingPartNumber String
  description     String
  cost            Float  @default(0)
  retailPrice     Float  @default(0)
  isRequired      Boolean @default(true)
  createdAt       DateTime @default(now())

  nagsPart NAGSPart @relation(fields: [nagsPartId], references: [id])

  @@index([nagsPartId])
}

// Transfer between shops
model InventoryTransfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique
  fromShopId      String
  toShopId        String
  nagsPartNumber  String
  quantity        Int
  status          String   @default("pending") // pending, in_transit, received, cancelled
  requestedBy     String
  approvedBy      String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromShop Shop @relation("TransferFrom", fields: [fromShopId], references: [id])
  toShop   Shop @relation("TransferTo", fields: [toShopId], references: [id])

  @@index([fromShopId])
  @@index([toShopId])
  @@index([status])
}

// Purchase orders for restocking
model PurchaseOrder {
  id              String   @id @default(uuid())
  poNumber        String   @unique
  shopId          String
  vendor          String
  status          String   @default("draft") // draft, submitted, confirmed, shipped, received, cancelled
  subtotal        Float    @default(0)
  shippingCost    Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  orderedAt       DateTime?
  expectedAt      DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop      Shop                @relation(fields: [shopId], references: [id])
  lineItems PurchaseOrderItem[]

  @@index([shopId])
  @@index([status])
  @@index([vendor])
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  nagsPartNumber   String
  description      String
  quantity         Int
  receivedQuantity Int    @default(0)
  unitCost         Float
  total            Float
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// ═══════════════════════════════════════════════
// SCHEDULING & DISPATCH
// ═══════════════════════════════════════════════

model ScheduleEntry {
  id                String   @id @default(uuid())
  workOrderId       String   @unique
  podId             String?
  technicianId      String?
  shopId            String
  date              DateTime
  slot              String   @default("morning")
  startTime         String
  endTime           String
  estimatedDuration Int      @default(90) // minutes
  isConfirmed       Boolean  @default(false)
  reminderSent      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id])
  pod        Pod?      @relation(fields: [podId], references: [id])
  technician User?     @relation(fields: [technicianId], references: [id])
  shop       Shop      @relation(fields: [shopId], references: [id])

  @@index([date])
  @@index([podId, date])
  @@index([technicianId, date])
  @@index([shopId, date])
}

// ═══════════════════════════════════════════════
// INSURANCE / CLAIMS (EDI)
// ═══════════════════════════════════════════════

model InsuranceClaim {
  id                    String  @id @default(uuid())
  workOrderId           String  @unique
  claimNumber           String
  policyNumber          String
  insuranceCompanyCode  String
  insuranceCompanyName  String
  adjusterName          String?
  adjusterPhone         String?
  adjusterEmail         String?
  dateOfLoss            DateTime
  status                String  @default("draft")
  approvalNumber        String?
  approvedAmount        Float   @default(0)
  deductible            Float   @default(0)
  customerResponsibility Float  @default(0)
  ediReferralId         String?
  ediLastTransactionType String?
  ediLastTransactionDate DateTime?
  deductibleWaiver      Boolean @default(false)
  waiverAmount          Float   @default(0)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id])
  ediMessages EDIMessage[]

  @@index([claimNumber])
  @@index([insuranceCompanyCode])
  @@index([status])
}

model EDIMessage {
  id               String   @id @default(uuid())
  claimId          String
  transactionType  String   // 837, 835, 824, etc.
  direction        String   // inbound, outbound
  rawContent       String
  parsedData       String?
  status           String   @default("sent") // sent, received, processed, error
  errorMessage     String?
  createdAt        DateTime @default(now())

  claim InsuranceClaim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([transactionType])
}

// ═══════════════════════════════════════════════
// INVOICES
// ═══════════════════════════════════════════════

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  workOrderId    String   @unique
  customerId     String
  shopId         String
  status         String   @default("draft")
  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  discount       Float    @default(0)
  total          Float    @default(0)
  amountPaid     Float    @default(0)
  amountDue      Float    @default(0)
  dueDate        DateTime
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrder  WorkOrder          @relation(fields: [workOrderId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  shop       Shop               @relation(fields: [shopId], references: [id])
  lineItems  InvoiceLineItem[]
  payments   Payment[]

  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float
  isTaxable   Boolean @default(true)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ═══════════════════════════════════════════════
// POS / PAYMENTS
// ═══════════════════════════════════════════════

model Payment {
  id                String   @id @default(uuid())
  invoiceId         String
  shopId            String
  posSessionId      String?
  transactionType   String   @default("sale") // sale, refund, void
  paymentMethod     String   // cash, credit_card, debit_card, check, insurance_direct, etc.
  amount            Float
  tipAmount         Float    @default(0)
  processingFee     Float    @default(0)
  netAmount         Float
  status            String   @default("pending")
  referenceNumber   String?
  authorizationCode String?
  cardLast4         String?
  cardBrand         String?
  checkNumber       String?
  receiptNumber     String   @unique
  processedById     String
  processedAt       DateTime @default(now())
  voidedAt          DateTime?
  voidedBy          String?
  refundReason      String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  processedBy User        @relation("ProcessedBy", fields: [processedById], references: [id])
  posSession  POSSession? @relation(fields: [posSessionId], references: [id])

  @@index([invoiceId])
  @@index([receiptNumber])
  @@index([posSessionId])
  @@index([paymentMethod])
  @@index([processedAt])
}

model POSSession {
  id              String    @id @default(uuid())
  shopId          String
  userId          String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingBalance  Float     @default(0)
  closingBalance  Float?
  cashSales       Float     @default(0)
  cardSales       Float     @default(0)
  checkSales      Float     @default(0)
  insuranceSales  Float     @default(0)
  totalSales      Float     @default(0)
  totalRefunds    Float     @default(0)
  netSales        Float     @default(0)
  transactionCount Int      @default(0)
  isOpen          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id])
  user              User               @relation("SessionUser", fields: [userId], references: [id])
  payments          Payment[]
  cashDrawerActions CashDrawerAction[]

  @@index([shopId])
  @@index([isOpen])
}

model CashDrawerAction {
  id           String   @id @default(uuid())
  sessionId    String
  type         String   // open, close, drop, paid_in, paid_out
  amount       Float
  reason       String?
  performedById String
  performedAt  DateTime @default(now())

  session     POSSession @relation(fields: [sessionId], references: [id])
  performedBy User       @relation(fields: [performedById], references: [id])

  @@index([sessionId])
}

// ═══════════════════════════════════════════════
// QUOTES
// ═══════════════════════════════════════════════

model Quote {
  id                 String   @id @default(uuid())
  quoteNumber        String   @unique
  customerId         String?
  shopId             String
  vehicleYear        Int
  vehicleMake        String
  vehicleModel       String
  vehicleSubModel    String?
  vin                String?
  glassPosition      String
  jobType            String   @default("replacement")
  nagsPartNumber     String?
  partDescription    String?
  partType           String   @default("aftermarket")
  partCost           Float    @default(0)
  laborCost          Float    @default(0)
  moldingCost        Float    @default(0)
  kitCost            Float    @default(0)
  calibrationCost    Float    @default(0)
  otherCharges       Float    @default(0)
  discount           Float    @default(0)
  taxAmount          Float    @default(0)
  totalAmount        Float    @default(0)
  isInsuranceJob     Boolean  @default(false)
  insuranceCompanyCode String?
  deductible         Float    @default(0)
  customerPays       Float    @default(0)
  insurancePays      Float    @default(0)
  validUntil         DateTime
  isConverted        Boolean  @default(false)
  convertedWorkOrderId String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  shop     Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([customerId])
  @@index([quoteNumber])
}

// ═══════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  readAt    DateTime?
  actionUrl String?
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════
// AGENT REFERRALS (MA insurance agent inbound)
// ═══════════════════════════════════════════════

model AgentReferral {
  id              String    @id @default(uuid())
  // Agent (the referrer)
  agentName       String
  agentEmail      String
  agentPhone      String?
  agencyName      String?
  agentCity       String?
  // Customer (the insured)
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerCity    String?
  customerZip     String?
  // Vehicle / claim basics
  vehicleYear     String?
  vehicleMake     String?
  vehicleModel    String?
  damage          String?   // e.g. "windshield crack"
  carrier         String?   // insurance carrier
  claimNumber     String?
  notes           String?
  // Lifecycle
  status          String    @default("new") // new, contacted, scheduled, completed, declined
  source          String    @default("agent_portal")
  firstContactAt  DateTime?
  scheduledAt     DateTime?
  completedAt     DateTime?
  workOrderId     String?
  // Tracking
  receivedAt      DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agentEmail])
  @@index([status])
  @@index([receivedAt])
}

// ═══════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // create, update, delete, login, logout, etc.
  entity     String   // work_order, customer, payment, etc.
  entityId   String?
  oldData    String?
  newData    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
